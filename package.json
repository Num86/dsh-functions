{
  "name": "dsh-functions",
  "version": "0.5.0",
  "description": "功能栏：给 DSH 客户端顶端加一个可扩展的「功能」标签，插件一行注册就能加一键功能；自带了重启 DSH 功能（不再需要单独装 dsh-function-restart）",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "functions",
    "menu",
    "命令面板",
    "restart"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./restart": "./restart.js",
    "./locale/*.json": "./locale/*.json",
    "./restart/locale/*.json": "./restart/locale/*.json",
    "./restart/icon": "./restart/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "restart.js",
    "restart-helper.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "restart/locale/*.json",
    "restart/icon.svg",
    "test"
  ],
  "author": "Num86",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Num86/dsh-functions.git"
  },
  "bugs": {
    "url": "https://github.com/Num86/dsh-functions/issues"
  },
  "homepage": "https://github.com/Num86/dsh-functions#readme"
}
